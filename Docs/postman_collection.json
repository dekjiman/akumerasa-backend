{
  "info": {
    "name": "Akumerasa Backend API Collection",
    "description": "Complete Postman collection for Akumerasa Backend API endpoints (Auth, Admin Management, Kiosk Devices, Public, Webhook)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_token", "value": "" },
    { "key": "device_token", "value": "" },
    { "key": "reference", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('admin_token', jsonData.data.token);",
                  "    console.log('Admin Token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@refleksidiri.id\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pengurus Masjid Baru\",\n  \"email\": \"pengurus@masjid.com\",\n  \"password\": \"password123\",\n  \"phone\": \"081234567890\"\n}"
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/auth/verify-email",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"sample_verification_token_here\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/auth/forgot-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@refleksidiri.id\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/auth/reset-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"sample_reset_token\",\n  \"password\": \"newpassword123\"\n}"
            }
          }
        },
        {
          "name": "Resend Verification",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/auth/resend-verification",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pengurus@masjid.com\"\n}"
            }
          }
        },
        {
          "name": "Device Activate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.device_token) {",
                  "    pm.collectionVariables.set('device_token', jsonData.data.device_token);",
                  "    console.log('Device Token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/auth/device/activate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activation_code\": \"123456\",\n  \"device_fingerprint\": \"fp_sample_kiosk_001\",\n  \"platform\": \"android\",\n  \"app_version\": \"1.0.0\",\n  \"device_name\": \"Kiosk Front Hall\"\n}"
            }
          }
        },
        {
          "name": "Device Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/auth/device/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kiosk_code\": \"KSK-001\",\n  \"device_secret\": \"sample_secret\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"sample_refresh_token\"\n}"
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/endpoint/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        },
        {
          "name": "Get My Permissions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/endpoint/auth/my-permissions",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/auth/logout",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        }
      ]
    },

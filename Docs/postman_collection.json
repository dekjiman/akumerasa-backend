    {
      "name": "Public - Donations & Results",
      "item": [
        {
          "name": "Create Donation (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.donation && jsonData.data.donation.reference) {",
                  "    pm.collectionVariables.set('reference', jsonData.data.donation.reference);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/endpoint/public/donasi",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000,\n  \"payment_method\": \"qris\",\n  \"session_id\": 1,\n  \"tenant_id\": 1,\n  \"donor_name\": \"Ahmad Fauzi\",\n  \"campaign_id\": 1\n}"
            }
          }
        },
        {
          "name": "Check Payment Status",

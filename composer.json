{
    "name": "refleksi/backend",
    "description": "Refleksi Diri Backend API - CodeIgniter 4",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "chillerlan/php-qrcode": "^6.0",
        "codeigniter4/framework": "^4.7",
        "firebase/php-jwt": "^6.0",
        "xendit/xendit-php": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Sites\\": "Sites/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
